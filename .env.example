# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Neon PostgreSQL Database
# Replace with your Neon connection string:
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Settings
NEXT_PUBLIC_APP_NAME="Ascent Onboarding"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =========================================================================
# Email Service Configuration (Workspace Invitations & Onboarding Mails)
# =========================================================================
# Option 1: Resend (Recommended - https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="Ascent Onboarding <onboarding@resend.dev>"

# Option 2: Standard SMTP (Gmail, Brevo, AWS SES, Mailgun, SendGrid)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="Ascent Onboarding <your-email@gmail.com>"
